---
import DefaultLayout from '../layouts/default.astro';
import '../scss/main.scss';
---

<DefaultLayout title="Unavailable">
    <div id="intro">
        <section id="parchment" class="slice-menu">
            <article id="unavailable-screen">
                <h1 class="title-decoration">Fuzzynuts World</h1>

                <p>
                    Fuzzynuts World is currently undergoing maintenance.
                    Check back soon or visit the
                    <a target="_blank" href="https://fuzzynuts.xyz/arcade/">Fuzzynuts Arcade</a> for updates.
                </p>
            </article>
        </section>
    </div>
</DefaultLayout>

<style is:global>
    #unavailable-screen {
        pointer-events: auto;
        opacity: 1;

        p {
            margin-top: 3em;
        }
    }
</style>
